&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> event &lt;span style="color:#ff79c6">=&lt;/span> &lt;span style="color:#f1fa8c">&amp;#34;VeryLazy&amp;#34;&lt;/span>,
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> opts &lt;span style="color:#ff79c6">=&lt;/span> {
