&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>Still --&amp;gt; Moving
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>Moving --&amp;gt; Still
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>Moving --&amp;gt; Crash
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>Crash --&amp;gt; [*]
