&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> Active :active, des2, 2014-01-07, 3d
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> Parallel 1 : des3, after des1, 1d
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> Parallel 2 : des4, after des1, 1d
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> Parallel 3 : des5, after des3, 1d
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> Parallel 4 : des6, after des4, 1d
